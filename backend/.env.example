# Backend-specific env (copy to .env)
# Most vars come from the root .env via docker-compose env_file,
# but this file documents what the Go server expects.

DATABASE_URL=postgres://dearly:changeme@postgres:5432/dearly?sslmode=disable
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092
SERVER_PORT=8080
GIN_MODE=debug

JWT_SECRET=replace-with-a-strong-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-sa.json
AI_SERVICE_URL=http://ai-service:5000
MIGRATIONS_PATH=./migrations
APP_TIMEZONE=Asia/Ho_Chi_Minh
