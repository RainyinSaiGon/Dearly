# ─── Secrets (NEVER commit these) ─────────────────────────────────
.env
*.json
!.env.example
# Re-allow non-secret JSON (package.json etc.) if needed:
# !some/path/package.json

# ─── Firebase / GCP credential files ──────────────────────────────
google-services.json
firebase-sa.json
gcp-sa.json
*-service-account*.json

# ─── Model weights (too large for git — use GDrive / DVC) ─────────
models/
*.ckpt
*.pt
*.pth
*.bin

# ─── Android ───────────────────────────────────────────────────────
android/.gradle/
android/.gradle-user/
android/app/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/local.properties
android/*.iml
android/.idea/

# ─── Go ────────────────────────────────────────────────────────────
backend/vendor/
backend/*.exe
backend/tmp/

# ─── Python ────────────────────────────────────────────────────────
ai-service/__pycache__/
ai-service/**/__pycache__/
ai-service/.venv/
ai-service/venv/
ai-service/*.egg-info/
ai-service/dist/
ai-service/.pytest_cache/
*.pyc
*.pyo

# ─── Docker ────────────────────────────────────────────────────────
.dockerignore

# ─── OS / Editor ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
