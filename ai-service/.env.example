# AI service env
OPENAI_API_KEY=sk-...
# The Colab handoff places the fine-tuned state at Dearly/models/ecapa_dearly.ckpt.
ECAPA_MODEL_PATH=/models/ecapa_dearly.ckpt
ECAPA_MODEL_SOURCE=speechbrain/spkrec-ecapa-voxceleb
ECAPA_MODEL_CACHE=/models/cache/ecapa
SV_COSINE_THRESHOLD=0.80
SID_COSINE_THRESHOLD=0.80
WHISPER_MODEL=base
WHISPER_MODEL_CACHE=/models/cache/whisper
WHISPER_LANGUAGE=vi
WHISPER_DEVICE=
WHISPER_FP16=false
OPENAI_INTENT_MODEL=gpt-4o-mini
