# ─── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_DB=dearly
POSTGRES_USER=dearly
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://dearly:changeme@postgres:5432/dearly?sslmode=disable

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ─── Firebase Admin SDK ───────────────────────────────────────────
# Download your service account JSON from Firebase Console →
# Project Settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-sa.json

# ─── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Google Cloud (ASR + TTS) ─────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json

# ─── AI Service ───────────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:5000
ECAPA_MODEL_PATH=/models/ecapa_voxceleb2.ckpt
SV_COSINE_THRESHOLD=0.80

# ─── Go API ───────────────────────────────────────────────────────
SERVER_PORT=8080
GIN_MODE=debug    # change to "release" for production
