# ─── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_DB=dearly
POSTGRES_USER=dearly
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://dearly:changeme@postgres:5432/dearly?sslmode=disable

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092

# ─── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ─── Firebase Admin SDK ───────────────────────────────────────────
# Download your service account JSON from Firebase Console →
# Project Settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-sa.json

# ─── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Google Cloud (ASR + TTS) ─────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json

# ─── AI Service ───────────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:5000
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Leave ECAPA_MODEL_PATH empty to use the pretrained SpeechBrain source.
# Point it at /models/ecapa_dearly.ckpt after Vietnamese fine-tuning.
ECAPA_MODEL_PATH=
ECAPA_MODEL_SOURCE=speechbrain/spkrec-ecapa-voxceleb
ECAPA_MODEL_CACHE=/models/cache/ecapa
SV_COSINE_THRESHOLD=0.80
SID_COSINE_THRESHOLD=0.80
WHISPER_MODEL=base
WHISPER_MODEL_CACHE=/models/cache/whisper
WHISPER_LANGUAGE=vi
OPENAI_INTENT_MODEL=gpt-4o-mini

# ─── Go API ───────────────────────────────────────────────────────
SERVER_PORT=8080
GIN_MODE=debug    # change to "release" for production
